# FAL_KEY: Required for real video generation and upscaling via fal.ai.
# Create a key in your fal.ai dashboard: https://fal.ai/dashboard/keys
# Server-side only — never exposed to the browser.
FAL_KEY="YOUR_FAL_API_KEY"

# --- Google OAuth (login restricted to @52launch.com) ---
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console.
# Authorized redirect URIs must include:
#   http://localhost:3001/auth/google/callback         (local dev)
#   https://<your-app>.fly.dev/auth/google/callback     (production)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# SESSION_SECRET: long random string used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# APP_URL: the public base URL of the app. Used to build the OAuth callback.
# Local dev can omit this (defaults to http://localhost:3001).
# In production set it to e.g. https://your-app.fly.dev
# APP_URL="https://your-app.fly.dev"

# DATA_DIR: where the SQLite DB (app.db) is stored. Defaults to ./data locally.
# On Fly.io, set to a mounted volume path, e.g. /data
# DATA_DIR="/data"

# Optional: port the server listens on (default 3001).
# FAL_PROXY_PORT=3001

# NODE_ENV=production  (set in production so secure cookies + static serving turn on)

# --- 52Launch pipeline ---
# GEMINI_API_KEY: server-side key for the pipeline's text/vision steps and VoxCraft voiceover.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Optional AI text model overrides
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# FAL_GEMINI_MODEL=google/gemini-3.5-flash-lite
# Set to true in development to create a sample "Kinetix" project when none exist.
# SEED_SAMPLE_PROJECT=false

# --- Google Drive connect (browser) ---
# No extra settings. "Connect Google Drive" reuses GOOGLE_CLIENT_ID above. In that
# Google Cloud project: enable the Drive API, set the OAuth consent screen to
# Internal with the .../auth/drive scope, and add this app's origin (for example
# https://<app>.fly.dev and http://localhost:3001) under "Authorized JavaScript
# origins" on the OAuth client. See DEPLOY.md.
