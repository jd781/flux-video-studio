    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@fal-ai/server-proxy": "^1.2.1",
    "@google/genai": "^2.4.0",
