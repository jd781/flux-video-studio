{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c green,cyan \"npm:server\" \"npm:vite\"",
    "vite": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx watch server/index.ts",
